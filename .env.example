## Copy this file to `.env` and paste your real tokens. DO NOT commit `.env`.

# Bot User OAuth Token (starts with xoxb-)
SLACK_BOT_TOKEN=

# App-Level Token for Socket Mode (starts with xapp-)
SLACK_APP_TOKEN=

# Optional: the slash command name you registered (e.g. /schoolbot-ping)
SLASH_COMMAND_NAME=/schoolbot-ping
APP_NAME=School WhatsApp Chatbot
APP_ENV=development
LOG_LEVEL=INFO
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886
TWILIO_VERIFY_TOKEN=school-chatbot
META_ACCESS_TOKEN=
META_PHONE_NUMBER_ID=1165060260030303
META_VERIFY_TOKEN=school-chatbot
